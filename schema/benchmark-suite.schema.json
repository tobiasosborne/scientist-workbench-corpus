{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientist-workbench-corpus/schema/benchmark-suite.schema.json",
  "title": "BenchmarkSuite",
  "description": "Tournament-protocol benchmark suite manifest. The verifier is declared as a generic command, with TS-on-Bun the convention but multiple escape hatches supported (python3, wolframscript, octave, Rscript, julia, sage, gap).",
  "type": "object",
  "required": ["meta", "verifier", "golden"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "domain"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string" },
        "domain":      { "type": "string", "description": "Mathematical domain: linalg, cas, integration, ode, optimisation, ..." },
        "description": { "type": "string" },
        "ported_from": { "type": "string", "description": "Provenance of the suite (e.g. 'scientist-workbench/bench/linalg-eigh@69dcfb8')." }
      }
    },
    "verifier": {
      "description": "Declares how to run the verifier. The verifier reads {input, candidate, id} on stdin and emits {pass, reason, checks: {name: {pass, detail}}} on stdout, exiting 0. Language-neutral.",
      "type": "object",
      "required": ["cmd", "args", "checks"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "Informational; cmd/args is authoritative.",
          "enum": ["bun", "python3", "wolframscript", "octave", "Rscript", "julia", "sage", "gap", "custom"]
        },
        "cmd":  { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "${SUITE_ROOT} is substituted to the absolute path of the suite directory."
        },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "additionalProperties": false,
            "properties": {
              "name":             { "type": "string" },
              "description":      { "type": "string" },
              "tolerance_source": { "type": "string", "description": "Citation backing the tolerance choice — e.g. 'Higham 2002 §20.6'." }
            }
          }
        }
      }
    },
    "golden": {
      "type": "object",
      "required": ["inputs", "expected", "n_cases"],
      "additionalProperties": false,
      "properties": {
        "inputs":          { "type": "string" },
        "inputs_sha256":   { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "expected":        { "type": "string" },
        "expected_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "n_cases":         { "type": "integer", "minimum": 1 },
        "regenerated_at":  { "type": "string" },
        "generate_cmd": {
          "type": "string",
          "description": "Shell command (run from suite root) to regenerate inputs.json + expected.json. Escape-hatch friendly: most generators are SciPy/SymPy/Mathematica because of oracle availability."
        }
      }
    }
  }
}
