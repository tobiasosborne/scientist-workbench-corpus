node_modules/
build/
*.log
.DS_Store
__pycache__/
*.pyc

# Raw LP test-problem downloads (regenerated by golden/generate.py from
# netlib.org as needed).  MANIFEST.toml + sha256.sum carry provenance;
# the bytes themselves stay local per "leave the big stuff local, push
# only the small subset" (decision 2026-05-11).  Each machine regenerates
# locally via `python3 benchmarks/lp-netlib/golden/generate.py`.
data/lp-netlib/raw/*.mps
data/lp-netlib/raw/*.raw
data/lp-netlib/raw/*.gz

# Compiled NETLIB SIF/emps decoder (platform-specific binary).
# emps.c is committed; each machine rebuilds emps from it via the
# generator's bootstrap step (`gcc -o emps emps.c`).
data/lp-netlib/emps
